		ranges = <0x1000000 0x00 0xf1100000 0x00 0xf1100000 0x00 0x100000 0x2000000 0x00 0xf1200000 0x00 0xf1200000 0x00 0xe00000 0x3000000 0x09 0x40000000 0x09 0x40000000 0x00 0x40000000>;
		reg = <0x0a 0x40400000 0x00 0x400000 0x00 0xfe160000 0x00 0x10000 0x00 0xf1000000 0x00 0x100000>;
		reg-names = "dbi", "apb", "config";
		resets = <0x21 0x127 0x21 0x12c>;
		reset-names = "pwr", "pipe";
		status = "disabled";
		phandle = <0x3bd>;

		legacy-interrupt-controller {
