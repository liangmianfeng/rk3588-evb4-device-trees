	analog-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "rk3588-es8388";
		simple-audio-card,format = "i2s";
		simple-audio-card,widgets = "Microphone", "Onboard Microphone", "Speaker", "Speaker", "Headphone", "Headphones";
		simple-audio-card,routing = "Headphones", "LOUT1",
                                            "Headphones", "ROUT1",
                                            "Speaker Amp INL", "LOUT2",
                                            "Speaker Amp INR", "ROUT2",
                                            "Speaker", "Speaker Amp OUTL",
                                            "Speaker", "Speaker Amp OUTR",
                                            "LINPUT2", "Onboard Microphone",
                                            "RINPUT2", "Onboard Microphone";
		simple-audio-card,hp-det-gpios = <0x137 0x1d 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x150>;
		simple-audio-card,mclk-fs = <0x100>;
                simple-audio-card,aux-devs = <&speaker_amp>;

                simple-audio-card,additional-devs {
                        speaker_amp: speaker-amplifier {
                                compatible = "simple-audio-amplifier";
                                enable-gpios = <&gpio3 25 0>;
                                sound-name-prefix = "Speaker Amp";
                        };
                };


	
	simple-audio-card,cpu {
			sound-dai = <0x19e>;
		};

		simple-audio-card,codec {
			sound-dai = <0x1ec>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <0x151>;

		led_rgb_b {
			function = "status";
			color = <0x03>;
			gpios = <0xa1 0x0f 0x00>;
			linux,default-trigger = "heartbeat";
		};
	};

