	};

	hdmi0-con {
		compatible = "hdmi-connector";
		type = "a";

		port {

			endpoint {
				remote-endpoint = <0x14a>;
				phandle = <0x86>;
			};
		};
	};

	hdmi1-con {
		compatible = "hdmi-connector";
		type = "a";

		port {

			endpoint {
				remote-endpoint = <0x14b>;
				phandle = <0x130>;
			};
		};
	};

	pwm-fan {
		compatible = "pwm-fan";
		cooling-levels = <0x00 0x78 0x96 0xb4 0xd2 0xf0 0xff>;
		fan-supply = <0x2d>;
		pwms = <0x14c 0x00 0xc350 0x00>;
		#cooling-cells = <0x02>;
		phandle = <0xf6>;
	};

